# Neon → Dashboard → Connect. Pooled-строка (хост с -pooler) для сайта и воркера:
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Прямая строка (хост без -pooler) для миграций; если не задана, берётся DATABASE_URL:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# LLM для резюме отзывов (достаточно одного; порядок фолбэка: Groq → Gemini → LLM_*)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Летсплеи: YouTube Data API (Google Cloud → YouTube Data API v3 → API key) + Gemini (AI Studio).
# GEMINI_API_KEY заодно включает Gemini как запасной провайдер для резюме отзывов.
YOUTUBE_API_KEY=
LETSPLAY_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=
# LLM_MODEL=

# Ежечасный запуск: cron-job.org → GET /api/cron (Authorization: Bearer CRON_SECRET) → workflow_dispatch.
# Нужны только в переменных Vercel.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=   # fine-grained PAT: только этот репозиторий, Actions: Read and write

SERVICE_TZ=Europe/Moscow
LOG_LEVEL=INFO
