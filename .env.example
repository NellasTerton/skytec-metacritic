# Neon → Dashboard → Connect. Pooled-строка (хост с -pooler) для сайта и воркера:
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Прямая строка (хост без -pooler) для миграций; если не задана, берётся DATABASE_URL:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# LLM для резюме отзывов (достаточно одного; порядок фолбэка: Groq → Gemini → LLM_*)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=
# LLM_MODEL=

SERVICE_TZ=Europe/Moscow
LOG_LEVEL=INFO
